{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "kit": {
      "source": {
        "source": "github",
        "repo": "Codexup5/kit"
      }
    }
  },
  "enabledPlugins": {
    "kit@kit": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git mv *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -q -m *)",
      "Bash(git fetch origin main)",
      "Bash(git switch -c *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(kit-check-step *)",
      "Bash(kit-plan-steps *)",
      "Bash(kit-commit *)",
      "Bash(kit-gate-stats)",
      "Bash(kit-gate-stats *)",
      "Bash(kit-audit-harness)",
      "Bash(kit-board *)",
      "Bash(kit-config *)",
      "Bash(kit-lanes *)",
      "Bash(kit-lesson *)",
      "Bash(kit-check-branch *)",
      "Workflow(kit:ship)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm knip)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm test:visual*)",
      "Bash(pnpm verify)",
      "Bash(pnpm context*)",
      "Bash(pnpm tokens*)",
      "Bash(pnpm csp*)",
      "Bash(pnpm size)",
      "Bash(pnpm build)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec stylelint *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec steiger *)",
      "Bash(node scripts/gen-context.mjs)",
      "Bash(node scripts/gen-context.mjs *)"
    ],
    "deny": [
      "PowerShell",
      "Bash(git push)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Bash(git push*--delete*)",
      "Bash(git push* -d *)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--all*)",
      "Bash(git push*--no-verify*)",
      "Bash(git push* HEAD*)",
      "Bash(git push* main)",
      "Bash(git push* master)",
      "Bash(git push*:main)",
      "Bash(git push*:master)",
      "Bash(git push*/main)",
      "Bash(git push*/master)",
      "Bash(gh pr merge*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit * -n*)",
      "Bash(git commit*--amend*)",
      "Bash(git reset --hard*)",
      "Bash(kit-mode *)",
      "Edit(./.claude/kit-mode.local)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "enabledMcpjsonServers": ["playwright"]
}
