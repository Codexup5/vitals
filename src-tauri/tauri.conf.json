{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitals",
  "version": "0.1.0",
  "identifier": "io.github.codexup5.vitals",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../crates/vitals-ui",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../crates/vitals-ui"
    },
    "frontendDist": "../crates/vitals-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vitals",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "create": false,
        "visible": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
