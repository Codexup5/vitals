{
  "name": "vitals",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.scss",
    "./src/app/main.tsx"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/tsc-baseline.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/tsc-baseline.mjs",
    "typecheck:baseline": "node scripts/tsc-baseline.mjs --update",
    "lint": "node tooling/eslint.mjs . --max-warnings=0",
    "lint:fix": "node tooling/eslint.mjs . --fix",
    "lint:baseline": "node tooling/eslint.mjs --baseline",
    "lint:arch": "node tooling/debt/debt.mjs steiger",
    "lint:arch:baseline": "node tooling/debt/debt.mjs steiger --baseline",
    "lint:placement": "node tooling/debt/debt.mjs placement",
    "lint:placement:baseline": "node tooling/debt/debt.mjs placement --baseline",
    "lint:styles": "node tooling/debt/debt.mjs stylelint",
    "lint:styles:baseline": "node tooling/debt/debt.mjs stylelint --baseline",
    "debt:sync": "node tooling/debt/sync.mjs",
    "tokens": "node tooling/design/tokens.mjs",
    "tokens:check": "node tooling/design/tokens.mjs --check",
    "tokens:baseline": "node tooling/design/tokens.mjs --baseline",
    "csp:check": "node tooling/security/check-csp.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "node tooling/debt/debt.mjs knip",
    "knip:baseline": "node tooling/debt/debt.mjs knip --baseline",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docker": "node scripts/playwright-docker.mjs",
    "test:visual": "node scripts/playwright-docker.mjs --visual",
    "test:visual:update": "node scripts/playwright-docker.mjs --visual --update",
    "size": "size-limit",
    "context": "node scripts/gen-context.mjs",
    "context:check": "node scripts/gen-context.mjs --check",
    "canon": "node scripts/gen-canon.mjs",
    "canon:check": "node scripts/gen-canon.mjs --check",
    "mutation": "stryker run",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:styles && pnpm tokens:check && pnpm csp:check && pnpm lint:arch && pnpm lint:placement && pnpm format:check && pnpm knip && pnpm context:check && pnpm canon:check && pnpm run --if-present conventions && pnpm test",
    "prepare": "husky",
    "tauri": "tauri",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "rust": "pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "conventions": "pnpm rust"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "1.63.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@size-limit/preset-app": "^14.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "colorjs.io": "^0.7.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "size-limit": "^14.1.0",
    "steiger": "^0.7.0",
    "style-dictionary": "^5.7.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.0"
}
