{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "leptos",
        "leptos_*"
      ],
      "groupName": "leptos"
    },
    {
      "matchPackageNames": [
        "tauri",
        "tauri-*"
      ],
      "groupName": "tauri"
    },
    {
      "matchPackageNames": [
        "wasm-bindgen",
        "wasm-bindgen-*",
        "js-sys",
        "web-sys"
      ],
      "groupName": "wasm-bindgen"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
