VITE_API_URL=https://api.example.com
VITE_API_MOCKS=false
# VITE_SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# VITE_RELEASE — the Sentry release; in CI it is the commit SHA
# Sourcemaps are uploaded at build time only with SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT (CI: secrets and vars)
# VITE_VITALS_URL=/api/vitals — the beacon URL of the Web Vitals; unset sends none
