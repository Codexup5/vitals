{
  "gates": {
    "place": [
      {
        "id": "placement",
        "match": "src/**",
        "run": [
          "node",
          "tooling/placement.mjs",
          "{file}"
        ]
      }
    ],
    "edit": [
      {
        "id": "prettier",
        "match": "**/*.{ts,tsx,js,mjs,scss,json,md,yml,yaml,html}",
        "blocking": false,
        "run": [
          "prettier",
          "--write",
          "--ignore-unknown",
          "--log-level=warn",
          "{file}"
        ]
      },
      {
        "id": "eslint",
        "match": "**/*.{ts,tsx,js,mjs}",
        "modes": [
          "canon",
          "strict"
        ],
        "run": [
          "node",
          "tooling/eslint.mjs",
          "--fix",
          "--cache",
          "--cache-strategy",
          "content",
          "--cache-location",
          "node_modules/.cache/eslint/",
          "--max-warnings=0",
          "--no-warn-ignored",
          "{file}"
        ]
      },
      {
        "id": "stylelint",
        "match": "**/*.scss",
        "modes": [
          "canon",
          "strict"
        ],
        "run": [
          "node",
          "tooling/debt/debt.mjs",
          "stylelint",
          "--fix",
          "{file}"
        ]
      }
    ],
    "stop": [
      {
        "id": "typecheck",
        "when": [
          "src/**",
          "mocks/**",
          "tooling/**",
          "server/**",
          "api/**"
        ],
        "run": [
          "node",
          "scripts/tsc-baseline.mjs"
        ]
      },
      {
        "id": "steiger",
        "when": [
          "src/**",
          "mocks/**",
          "tooling/**"
        ],
        "run": [
          "node",
          "tooling/debt/debt.mjs",
          "steiger"
        ]
      },
      {
        "id": "design-tokens",
        "when": "src/shared/styles/**",
        "run": [
          "node",
          "tooling/design/tokens.mjs",
          "--check"
        ]
      },
      {
        "id": "csp",
        "when": [
          "csp.json",
          "index.html",
          "tooling/security/**"
        ],
        "run": [
          "node",
          "tooling/security/check-csp.mjs"
        ]
      },
      {
        "id": "vitest-related",
        "match": "**/*.{ts,tsx,js,mjs}",
        "modes": [
          "strict"
        ],
        "run": [
          "vitest",
          "related",
          "--run",
          "{files}"
        ]
      }
    ],
    "step": [
      {
        "id": "eslint",
        "match": "**/*.{ts,tsx,js,mjs}",
        "run": [
          "node",
          "tooling/eslint.mjs",
          "--cache",
          "--cache-strategy",
          "content",
          "--cache-location",
          "node_modules/.cache/eslint/",
          "--max-warnings=0",
          "--no-warn-ignored",
          "{files}"
        ]
      },
      {
        "id": "typecheck",
        "when": "**/*.{ts,tsx}",
        "run": [
          "node",
          "scripts/tsc-baseline.mjs"
        ]
      },
      {
        "id": "context",
        "when": "src/**/*.{ts,tsx,js,mjs}",
        "run": [
          "node",
          "scripts/gen-context.mjs",
          "--check"
        ]
      },
      {
        "id": "canon",
        "when": [
          ".claude/rules/**",
          "docs/gates.md",
          ".claude/skills/**"
        ],
        "run": [
          "node",
          "scripts/gen-canon.mjs",
          "--check"
        ]
      },
      {
        "id": "design-tokens",
        "when": "src/shared/styles/**",
        "run": [
          "node",
          "tooling/design/tokens.mjs",
          "--check"
        ]
      },
      {
        "id": "csp",
        "when": [
          "csp.json",
          "index.html",
          "tooling/security/**"
        ],
        "run": [
          "node",
          "tooling/security/check-csp.mjs"
        ]
      },
      {
        "id": "vitest-related",
        "match": "**/*.{ts,tsx,js,mjs}",
        "skipInTestStep": true,
        "cap": true,
        "run": [
          "vitest",
          "related",
          "--run",
          "{files}"
        ]
      }
    ],
    "oracle": [
      {
        "id": "vitest-oracle",
        "match": "**/*.oracle.test.{ts,tsx,js}",
        "run": [
          "vitest",
          "run",
          "{files}"
        ]
      }
    ]
  },
  "cyrillic": {
    "allow": [
      "src/**/config/texts.ts",
      "src/**/*.test.{ts,tsx}",
      "e2e/**",
      "mocks/**",
      ".claude/evals/**/prompt.md"
    ]
  },
  "frozen": [
    "e2e/**",
    "**/*.test.*"
  ],
  "canon": [
    "**/.claude/rules/**",
    "**/CLAUDE.md",
    "**/kit.json",
    "**/eslint.config.js",
    "**/tooling/eslint-plugin-architecture/**",
    "**/stylelint.config.mjs",
    "**/steiger.config.mjs",
    "**/knip.json",
    "prettier.config.mjs",
    "commitlint.config.js",
    "**/lint-staged.config.js",
    ".husky/**",
    "**/.claude/settings.json",
    "**/tsconfig*.json"
  ],
  "forbid": [
    {
      "id": "skip",
      "pattern": "[.](skip|todo)([.]each|If)?[(]",
      "match": [
        "**/*.{ts,tsx,js,mjs}"
      ]
    },
    {
      "id": "only",
      "pattern": "[.]only([.]each)?[(]",
      "match": [
        "**/*.{ts,tsx,js,mjs}"
      ]
    },
    {
      "id": "eslint-disable",
      "pattern": "eslint-disable",
      "match": [
        "**/*.{ts,tsx,js,mjs}"
      ]
    },
    {
      "id": "ts-ignore",
      "pattern": "@ts-ignore",
      "match": [
        "**/*.{ts,tsx,js,mjs}"
      ]
    },
    {
      "id": "ts-expect-error",
      "pattern": "@ts-expect-error",
      "match": [
        "**/*.{ts,tsx,js,mjs}"
      ]
    },
    {
      "id": "ts-nocheck",
      "pattern": "@ts-nocheck",
      "match": [
        "**/*.{ts,tsx,js,mjs}"
      ]
    }
  ],
  "profiles": {
    "default": {
      "mcp": [
        "playwright",
        "sentry"
      ],
      "connectors": false,
      "model": "opus",
      "effort": "xhigh"
    }
  }
}
