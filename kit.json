{
  "gates": {
    "edit": [
      {
        "id": "rustfmt",
        "match": "**/*.rs",
        "blocking": false,
        "run": [
          "rustfmt",
          "--edition",
          "2024",
          "{file}"
        ]
      }
    ],
    "stop": [
      {
        "id": "clippy",
        "when": [
          "**/*.rs",
          "**/Cargo.toml"
        ],
        "run": [
          "cargo",
          "clippy",
          "--workspace",
          "--all-targets",
          "--locked",
          "--",
          "-D",
          "warnings"
        ]
      },
      {
        "id": "design",
        "when": [
          "crates/vitals-ui/styles/**",
          "crates/vitals-ui/tokens/**",
          "xtask/**"
        ],
        "run": [
          "cargo",
          "xtask",
          "check"
        ]
      }
    ],
    "step": [
      {
        "id": "clippy",
        "when": [
          "**/*.rs",
          "**/Cargo.toml"
        ],
        "run": [
          "cargo",
          "clippy",
          "--workspace",
          "--all-targets",
          "--locked",
          "--",
          "-D",
          "warnings"
        ]
      },
      {
        "id": "clippy-wasm",
        "when": [
          "crates/vitals-ui/**",
          "crates/vitals-ipc/**"
        ],
        "run": [
          "cargo",
          "clippy",
          "-p",
          "vitals-ui",
          "--target",
          "wasm32-unknown-unknown",
          "--locked",
          "--",
          "-D",
          "warnings"
        ]
      },
      {
        "id": "design",
        "when": [
          "crates/vitals-ui/styles/**",
          "crates/vitals-ui/tokens/**",
          "xtask/**"
        ],
        "run": [
          "cargo",
          "xtask",
          "check"
        ]
      },
      {
        "id": "test",
        "when": [
          "**/*.rs"
        ],
        "skipInTestStep": true,
        "run": [
          "cargo",
          "test",
          "--workspace",
          "--locked"
        ]
      }
    ]
  },
  "cyrillic": {
    "allow": [
      "crates/vitals-ui/src/texts.rs",
      "src-tauri/src/tray.rs"
    ]
  },
  "frozen": [],
  "canon": [
    "**/.claude/rules/**",
    "**/CLAUDE.md",
    "**/kit.json",
    "**/.claude/settings.json",
    "Cargo.toml",
    "clippy.toml",
    "**/Trunk.toml"
  ],
  "forbid": [
    {
      "id": "ignore",
      "pattern": "#\\[ignore",
      "match": [
        "**/*.rs"
      ]
    }
  ],
  "profiles": {
    "default": {
      "mcp": [
        "playwright"
      ],
      "connectors": false,
      "model": "opus",
      "effort": "xhigh"
    }
  }
}
