  "space": {
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "5": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "$type": "dimension",
    "$extensions": {
      "kit": {
        "role": "space"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    }
  },
  "font-family": {
    "$type": "fontFamily",
    "$value": ["Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI", "system-ui", "sans-serif"]
  },
  "font-family-mono": {
    "$type": "fontFamily",
    "$value": ["Maple Mono NF", "JetBrains Mono", "Cascadia Mono", "Consolas", "monospace"]
  },
  "font-size": {
    "$type": "dimension",
    "$extensions": {
      "kit": {
        "role": "font-size"
      }
    },
    "caption": {
      "$value": {
        "value": 13,
        "unit": "px"
      }
    },
    "body": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "title": {
      "$value": {
        "value": 22,
        "unit": "px"
      }
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "semibold": {
      "$value": 600
    }
  },
  "line-height": {
    "$type": "number",
    "body": {
      "$value": 1.5,
      "$extensions": {
        "kit": {
          "role": "line-height",
          "fontSize": "{font-size.body}"
        }
      }
    }
  },
  "touch-target": {
    "$type": "dimension",
    "$value": {
      "value": 32,
      "unit": "px"
    },
    "$extensions": {
      "kit": {
        "role": "target"
      }
    }
  },
  "content-width": {
    "$type": "dimension",
    "$value": {
      "value": 960,
      "unit": "px"
    },
    "$extensions": {
      "kit": {
        "role": "size"
      }
    }
  },
  "sidebar-width": {
    "$type": "dimension",
    "$value": {
      "value": 240,
      "unit": "px"
    },
    "$extensions": {
      "kit": {
        "role": "size"
      }
    }
  },
  "chart-height": {
